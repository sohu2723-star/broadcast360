generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(GUEST)
  createdAt DateTime @default(now())
}

model Channel {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  description       String?
  logo              String?
  country           String?
  streamKey         String?            @unique
  createdAt         DateTime           @default(now())
  broadcastSessions BroadcastSession[]

  createdAt DateTime @default(now())

  programs Program[]


  // 24/7 fallback playlist
  defaultPlaylistId Int?

  defaultPlaylist Playlist? @relation("ChannelDefaultPlaylist",fields: [defaultPlaylistId],references: [id])
}

model Stream {
  id            Int            @id @default(autoincrement())
  channelId     Int
  url           String
  protocol      String
  status        String         @default("offline")
  createdAt     DateTime       @default(now())
  playlistItems PlaylistItem[]
  channel       Channel        @relation(fields: [channelId], references: [id])
}

model Movie {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  genre         String?
  thumbnail     String?
  videoUrl      String?
  duration      Int
  releaseYear   Int?
  createdAt     DateTime       @default(now())
  playlistItems PlaylistItem[]
}

model Series {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  genre       String?
  releaseYear Int?
  thumbnail   String?
  createdAt   DateTime  @default(now())
  episodes    Episode[]
}

model Episode {
  id            Int            @id @default(autoincrement())
  seriesId      Int
  title         String
  episodeNo     Int
  duration      Int
  videoUrl      String?
  thumbnailUrl  String?
  createdAt     DateTime       @default(now())
  series        Series         @relation(fields: [seriesId], references: [id])
  playlistItems PlaylistItem[]

  @@unique([seriesId, episodeNo])
}

model Advertisement {
  id            Int            @id @default(autoincrement())
  title         String
  videoUrl      String
  thumbnailUrl  String?
  duration      Int
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  playlistItems PlaylistItem[]
}

model News {
  id            Int            @id @default(autoincrement())
  channelId     Int?
  title         String
  content       String?
  image         String?
  videoUrl      String?
  type          String
  createdAt     DateTime       @default(now())
  channel       Channel?       @relation(fields: [channelId], references: [id])
  playlistItems PlaylistItem[]
}

model Entertainment {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  category      String?
  thumbnail     String?
  videoUrl      String
  duration      Int
  releaseYear   Int?
  createdAt     DateTime       @default(now())
  playlistItems PlaylistItem[]
}

model Program {
  id          Int         @id @default(autoincrement())
  channelId   Int
  title       String
  type        ProgramType
  description String?
  createdAt   DateTime    @default(now())
  playlists   Playlist[]
  channel     Channel     @relation(fields: [channelId], references: [id])
}

model Playlist {
  id            Int            @id @default(autoincrement())
  name          String
  programId     Int
  totalDuration Int?
  createdAt     DateTime       @default(now())
  program       Program        @relation(fields: [programId], references: [id])
  items         PlaylistItem[]
  schedules     Schedule[]
}

model PlaylistItem {
  id              Int              @id @default(autoincrement())
  playlistId      Int
  order           Int
  type            PlaylistItemType
  movieId         Int?
  episodeId       Int?
  advertisementId Int?
  entertainmentId Int?
  newsId          Int?
  streamId        Int?
  duration        Int?
  createdAt       DateTime         @default(now())
  advertisement   Advertisement?   @relation(fields: [advertisementId], references: [id])
  entertainment   Entertainment?   @relation(fields: [entertainmentId], references: [id])
  episode         Episode?         @relation(fields: [episodeId], references: [id])
  movie           Movie?           @relation(fields: [movieId], references: [id])
  news            News?            @relation(fields: [newsId], references: [id])
  playlist        Playlist         @relation(fields: [playlistId], references: [id])
  stream          Stream?          @relation(fields: [streamId], references: [id])

  @@unique([playlistId, order])
}

model Schedule {
  id         Int            @id @default(autoincrement())
  channelId  Int
  playlistId Int
  startTime  DateTime
  endTime    DateTime?
  status     ScheduleStatus @default(SCHEDULED)
  createdAt  DateTime       @default(now())
  channel    Channel        @relation(fields: [channelId], references: [id])
  playlist   Playlist       @relation(fields: [playlistId], references: [id])
}

model BroadcastSession {
  id         Int             @id @default(autoincrement())
  channelId  Int
  scheduleId Int?
  status     BroadcastStatus @default(STOPPED)
  startedAt  DateTime?
  createdAt  DateTime        @default(now())
  channel    Channel         @relation(fields: [channelId], references: [id])
}

model Recording {
  id        Int      @id @default(autoincrement())
  channelId Int
  title     String
  fileUrl   String
  duration  Int
  startedAt DateTime
  endedAt   DateTime
