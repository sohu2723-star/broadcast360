generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================
// ENUMS
// =====================

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  KPAY
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
  FAILED
}

// NEW: Free / Premium content
enum AccessType {
  FREE
  PREMIUM
}

// =====================
// USER
// =====================

model User {
  id          Int        @id @default(autoincrement())
  name        String
  email       String     @unique
  password    String
  avatar      String?
  phone       String?
  role        Role       @default(USER)
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // NEW
  watchHistory WatchHistory[]

  // NEW
  subscriptions Subscription[]
}

// =====================
// WATCH HISTORY
// =====================

model WatchHistory {
  id Int @id @default(autoincrement())

  userId         Int
  newsId Int?
  playlistItemId Int?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistItem PlaylistItem? @relation(fields: [playlistItemId], references: [id], onDelete: Cascade)
  news News? @relation( fields: [newsId], references: [id], onDelete: Cascade)

  // For Continue Watching
  progressSeconds Int  @default(0)
  durationSeconds Int?

  watchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One user has one history record per playlist item
  @@unique([userId, playlistItemId])
  @@unique([userId, newsId])
  @@index([userId])
  @@index([userId, watchedAt])
}

// =====================
// SUBSCRIPTION PLAN
// =====================

model SubscriptionPlan {
  id Int @id @default(autoincrement())

  name         String
  price        Decimal
  durationDays Int

  description String?
  isActive    Boolean @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================
// SUBSCRIPTION
// =====================

model Subscription {
  id Int @id @default(autoincrement())

  userId Int
  planId Int

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(PENDING)

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

// =====================
// PAYMENT
// =====================

model Payment {
  id Int @id @default(autoincrement())

  subscriptionId Int

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount   Decimal
  currency String  @default("MMK")

  method PaymentMethod @default(KPAY)

  transactionId String?
  screenshotUrl String?

  status PaymentStatus @default(PENDING)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================
// CHANNEL
// =====================

model Channel {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  description       String?
  logo              String?
  country           String?
  streams           Stream[]
  streamKey         String             @unique
  news              News[]
  schedules         Schedule[]
  recordings        Recording[]
  broadcastSessions BroadcastSession[]
  createdAt         DateTime           @default(now())
  programs          Program[]

  // 24/7 fallback playlist
  defaultPlaylistId Int?
  defaultPlaylist   Playlist? @relation("ChannelDefaultPlaylist", fields: [defaultPlaylistId], references: [id])
}

// =====================
// MOVIE
// =====================

model Movie {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  genre       String?
  thumbnail   String?
  videoUrl    String?
  duration    Int
  releaseYear Int?
  createdAt   DateTime @default(now())

  // NEW
  accessType AccessType @default(FREE)

  playlistItems PlaylistItem[]

  @@unique([title, releaseYear])
}

// =====================
// STREAM PROTOCOL
// =====================

enum StreamProtocol {
  RTSP
  RTMP
  HLS
  WEBRTC
}

enum StreamStatus {
  ONLINE
  OFFLINE
}

// ============================
// STREAM INPUT
// ============================

model Stream {
  id          Int            @id @default(autoincrement())
  channelId   Int
  name        String
  url         String
  protocol    StreamProtocol
  status      StreamStatus   @default(OFFLINE)
  description String?
  createdAt   DateTime       @default(now())

  channel Channel @relation(fields: [channelId], references: [id])

  playlistItems PlaylistItem[]
}

// =====================
// SERIES
// =====================

model Series {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  genre       String?
  releaseYear Int?
  thumbnail   String?
  episodes    Episode[]
  createdAt   DateTime  @default(now())
}

// =====================
// EPISODE
// =====================

model Episode {
  id           Int     @id @default(autoincrement())
  seriesId     Int
  title        String
  episodeNo    Int
  duration     Int
  videoUrl     String?
  thumbnailUrl String?

  // NEW
  accessType AccessType @default(FREE)

  series Series @relation(fields: [seriesId], references: [id])

  playlistItems PlaylistItem[]

  createdAt DateTime @default(now())
}

// =====================
// ADVERTISEMENT
// =====================

model Advertisement {
  id           Int      @id @default(autoincrement())
  title        String
  videoUrl     String
  thumbnailUrl String?
  duration     Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  playlistItems PlaylistItem[]
}

// =====================
// NEWS
// =====================

model News {
  id Int @id @default(autoincrement())

  channelId   Int?
  recordingId Int?

  title    String
  content  String?
  image    String?
  videoUrl String?
  duration Int?
  type     String

  accessType AccessType @default(FREE)

  channel   Channel?   @relation(fields: [channelId], references: [id])
  recording Recording? @relation(fields: [recordingId], references: [id])

  playlistItems PlaylistItem[]

  watchHistories WatchHistory[]

  createdAt DateTime @default(now())
}

// =====================
// ENTERTAINMENT
// =====================

model Entertainment {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String?
  thumbnail   String?
  videoUrl    String
  duration    Int
  releaseYear Int?
  createdAt   DateTime @default(now())

  // NEW
  accessType AccessType @default(FREE)

  playlistItems PlaylistItem[]
}

// =====================
// PROGRAM
// =====================

enum ProgramType {
  MOVIE
  SERIES
  NEWS
  LIVE
  ENTERTAINMENT
}

model Program {
  id          Int         @id @default(autoincrement())
  channelId   Int
  title       String
  type        ProgramType
  description String?
  playlists   Playlist[]
  channel     Channel     @relation(fields: [channelId], references: [id])
  createdAt   DateTime    @default(now())
}

// =====================
// PLAYLIST
// =====================

model Playlist {
  id            Int    @id @default(autoincrement())
  name          String
  programId     Int
  totalDuration Int?

  program Program @relation(fields: [programId], references: [id])

  items     PlaylistItem[]
  schedules Schedule[]

  createdAt DateTime @default(now())

  // Existing relation - unchanged
  defaultForChannels Channel[] @relation("ChannelDefaultPlaylist")
}

// =====================
// PLAYLIST ITEM
// =====================

enum PlaylistItemType {
  MOVIE
  EPISODE
  ADVERTISEMENT
  ENTERTAINMENT
  NEWS
  STREAM
}

model PlaylistItem {
  id              Int              @id @default(autoincrement())
  playlistId      Int
  order           Int
  type            PlaylistItemType
  movieId         Int?
  episodeId       Int?
  advertisementId Int?
  entertainmentId Int?
  newsId          Int?
  streamId        Int?
  duration        Int?

  playlist      Playlist       @relation(fields: [playlistId], references: [id])
  movie         Movie?         @relation(fields: [movieId], references: [id])
  episode       Episode?       @relation(fields: [episodeId], references: [id])
  advertisement Advertisement? @relation(fields: [advertisementId], references: [id])
  news          News?          @relation(fields: [newsId], references: [id])
  stream        Stream?        @relation(fields: [streamId], references: [id])
  entertainment Entertainment? @relation(fields: [entertainmentId], references: [id])

  // NEW
  watchHistory WatchHistory[]

  createdAt DateTime @default(now())

  @@unique([playlistId, order])
}

// =====================
// SCHEDULE
// =====================

enum ScheduleStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model Schedule {
  id         Int            @id @default(autoincrement())
  channelId  Int
  playlistId Int
  startTime  DateTime
  endTime    DateTime?
  status     ScheduleStatus @default(SCHEDULED)

  channel  Channel  @relation(fields: [channelId], references: [id])
  playlist Playlist @relation(fields: [playlistId], references: [id])

  sessions BroadcastSession[]

  createdAt DateTime @default(now())
}

// =====================
// BROADCAST SESSION
// =====================

enum BroadcastStatus {
  STARTING
  LIVE
  SWITCHING
  STOPPING
  STOPPED
  ERROR
}

model BroadcastSession {
  id Int @id @default(autoincrement())

  channelId  Int  @unique
  scheduleId Int?

  status BroadcastStatus @default(STOPPED)

  startedAt DateTime?
  stoppedAt DateTime?

  currentItemId Int?

  errorMessage String?

  channel  Channel   @relation(fields: [channelId], references: [id])
  schedule Schedule? @relation(fields: [scheduleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================
// RECORDING
// =====================

model Recording {
  id Int @id @default(autoincrement())

  channelId Int

  title String

  fileUrl String

  duration Int

  startedAt DateTime
  endedAt   DateTime?

  channel Channel @relation(fields: [channelId], references: [id])

  news News[]

  createdAt DateTime @default(now())
}
