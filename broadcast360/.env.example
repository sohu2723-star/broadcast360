# Database
DATABASE_URL="postgresql://broadcast360:broadcast360@127.0.0.1:5432/broadcast360?schema=public"

# Authentication secrets: use different random values in production (32+ characters)
JWT_SECRET="replace-with-a-random-32-character-admin-secret"
JWT_SECRET_USER="replace-with-a-random-32-character-user-secret"

# Browser/API origins
NEXT_PUBLIC_URL="http://localhost:3000"
USER_PORTAL_ORIGIN="http://localhost:3001"

# MediaMTX / streaming service
MEDIA_SERVER_HOST="127.0.0.1"
MEDIA_MTX_HOST="127.0.0.1"
MEDIA_MTX_RTSP_PORT="8554"
MEDIA_MTX_RTMP_PORT="1935"
MEDIA_MTX_HLS_PORT="8888"
MEDIA_MTX_WEBRTC_PORT="8889"
PUBLIC_STREAM_ORIGIN="*"

# Set to production on the deployment host
NODE_ENV="development"

# Google Identity Services
GOOGLE_CLIENT_ID="your-broadcast360-web-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-broadcast360-web-client-id.apps.googleusercontent.com"
ADMIN_EMAILS="copy2723@gmail.com"

# EmailJS verification-code delivery (server-side only; keep values in Vercel env)
EMAILJS_SERVICE_ID="service_xxxxxxx"
EMAILJS_TEMPLATE_ID="template_xxxxxxx"
EMAILJS_PUBLIC_KEY="your-emailjs-public-key"

# SMTP fallback if EmailJS is not configured
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Broadcast360 <your-gmail@gmail.com>"
